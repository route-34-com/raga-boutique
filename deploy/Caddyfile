# /etc/caddy/Caddyfile — replace the domain. Caddy fetches HTTPS certificates itself
# (if Cloudflare proxies the domain, set SSL mode to "Full (strict)").
shop.example.in {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle /uploads/* {
		root * /srv/raga/backend
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/raga/frontend/dist
		try_files {path} /index.html
		file_server
	}
	request_body {
		max_size 15MB
	}
}
