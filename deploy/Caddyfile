# /etc/caddy/Caddyfile — replace the domain. Caddy fetches HTTPS certificates itself
# (if Cloudflare proxies the domain, set SSL mode to "Full (strict)").
shop.example.in {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle /uploads/* {
		root * /srv/raga/backend
		header Cache-Control "public, max-age=31536000, immutable"
		@stored file
		handle @stored {
			file_server
		}
		# A photo's smaller copy (".w480.jpg") not made yet: the API makes and keeps it.
		handle {
			reverse_proxy 127.0.0.1:8000
		}
	}
	handle /assets/* {
		root * /srv/raga/frontend/dist
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /brand/* {
		root * /srv/raga/frontend/dist
		file_server
	}
	# Pages, robots.txt and sitemap.xml come from the API: it fills each page's title, description and
	# structured data into frontend/dist/index.html for search engines, and answers 404 for unknown pages.
	handle {
		reverse_proxy 127.0.0.1:8000
	}
	request_body {
		max_size 15MB
	}
}
