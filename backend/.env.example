# Raga Boutique API settings. Copy to backend/.env. Every value below is the local-development default.
# Production checklist is in HANDOVER.md.

# ---- Core ----
# dev | demo | prod. "prod" refuses to start with the dev JWT_SECRET or OTP_PROVIDER=console.
ENV=dev
DATABASE_URL=postgresql+psycopg://raga:raga_dev@127.0.0.1:5432/raga
# Production: a long random string, e.g. `openssl rand -hex 32`. Changing it signs everyone out.
JWT_SECRET=dev-only-secret-change-me-in-production-0000
SESSION_DAYS=30
# Production (HTTPS): true
COOKIE_SECURE=false
# The site's public address; used in links inside emails and WhatsApp messages.
PUBLIC_SITE_URL=http://localhost:5173
# Only needed when the site and API are on different origins. JSON list.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- Admins ----
# Ten-digit mobiles that are always admins and the only ones who can add or remove admins. JSON list.
# Production: the shop owner's number(s), e.g. ["98XXXXXXXX"]. Empty = nobody can add or remove admins.
SUPER_ADMIN_PHONES=[]

# ---- Product photos ----
# disk = files in UPLOADS_DIR (back this folder up). db = stored in Postgres (hosts without a lasting disk).
IMAGE_STORE=disk
# UPLOADS_DIR=/var/lib/raga/uploads
# true only on serverless hosts (Vercel); turns off the database connection pool.
SERVERLESS=false

# ---- Login codes (OTP) ----
# console = demo: code shown on screen, no SMS. msg91 = real SMS (needs a DLT-approved template with ##otp##).
OTP_PROVIDER=console
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=

# ---- WhatsApp order messages ----
# tap = admin opens WhatsApp with the message typed and taps send. cloud = Meta WhatsApp Cloud API sends it.
WHATSAPP_MODE=tap
WHATSAPP_PHONE_ID=
# Permanent system-user token from Meta Business Manager.
WHATSAPP_TOKEN=
WHATSAPP_LANG=en

# ---- Email ----
# console = logged only. smtp = sent.
# Brevo: smtp-relay.brevo.com, port 587 (or 2525 where the host blocks 587, e.g. DigitalOcean).
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# e.g. Raga Boutique <orders@ragaboutique.in>
EMAIL_FROM=

# ---- Online payments ----
# off = cash/UPI on delivery only. demo = stand-in checkout, no money moves. razorpay = real payments.
PAYMENT_PROVIDER=off
# rzp_test_... to try with test cards, rzp_live_... when going live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Any long random string; the same value goes in Razorpay Dashboard → Webhooks.
RAZORPAY_WEBHOOK_SECRET=
