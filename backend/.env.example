ENV=dev
DATABASE_URL=postgresql+psycopg://raga:raga_dev@127.0.0.1:5432/raga
JWT_SECRET=dev-only-secret-change-me-in-production-0000
COOKIE_SECURE=false

# console = demo (code shown on screen, no SMS). msg91 = real SMS (needs a DLT-approved template).
OTP_PROVIDER=console
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=

# WhatsApp: tap = admin opens a typed message and taps send. cloud = Meta WhatsApp Cloud API sends it (see README).
WHATSAPP_MODE=tap
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_LANG=en

# Email: console = logged only (demo). smtp = sent (Brevo: smtp-relay.brevo.com, port 587).
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
PUBLIC_SITE_URL=http://localhost:5173
