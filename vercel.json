{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build && mkdir -p frontend/dist/uploads/products && cp backend/scripts/seed_images/*.jpg frontend/dist/uploads/products/ && mv frontend/dist/index.html frontend/dist/shell.html && mkdir -p backend/app/web && cp frontend/dist/shell.html backend/app/web/shell.html",
  "outputDirectory": "frontend/dist",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{frontend/**,deploy/**,backend/tests/**,backend/scripts/**,backend/alembic/**,backend/.venv/**,backend/uploads/**,.playwright-mcp/**}",
      "includeFiles": "backend/app/web/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!assets/|brand/).*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
